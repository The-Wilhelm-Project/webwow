# ---------------------------------------------------------------------------
# Webwow configuration
#
# Copy to `.env` for local development (`npm run dev`, `npm run migrate:*`).
# In Docker the same variables are passed as container environment
# (see docker-compose.yml). Nothing here is required at *build* time.
# ---------------------------------------------------------------------------

# --- Database (required) ---------------------------------------------------
# Plain PostgreSQL connection string. Webwow does not use Supabase; all
# SUPABASE_* variables from upstream ycode are ignored.
DATABASE_URL=postgresql://webwow:webwow_password@127.0.0.1:5432/webwow
# Set to `true` for managed databases that require TLS (self-signed certs are accepted).
DATABASE_SSL=
# Optional knex pool tuning (defaults: min 0, max 20; use max 10 in multi-site mode).
# DB_POOL_MIN=
# DB_POOL_MAX=

# --- Multi-site (docs/MULTISITE.md) ---------------------------------------
# Set to 1 to host several websites in one installation: every site gets its own
# PostgreSQL database next to DATABASE_URL (the DB role needs CREATEDB), the
# dashboard lives at /webwow. The flag is read at BUILD time and at runtime (with
# 1 the published pages render per request: host -> site). PAGE_AUTH_SECRET is
# mandatory in multi-site mode (it signs the site header and every session).
WEBWOW_MULTI_SITE=
# Host suffix for site previews: a request for <slug>.<base> serves that site.
# Unset: only <slug>.localhost works (local development).
WEBWOW_SITES_BASE_DOMAIN=
# Trust x-forwarded-host for site resolution. Set to 1 ONLY behind a reverse proxy
# that overwrites the header; otherwise the Host header is used.
WEBWOW_TRUSTED_PROXY=
# Connection budget. Two app pools of DB_POOL_MAX (main site), one registry/users
# pool of DB_POOL_MAIN_MAX and up to WEBWOW_MAX_SITE_POOLS site pools of
# DB_POOL_SITE_MAX must stay below PostgreSQL's max_connections (default 100):
#   2 x DB_POOL_MAX + DB_POOL_MAIN_MAX + WEBWOW_MAX_SITE_POOLS x DB_POOL_SITE_MAX < max_connections
# Defaults: DB_POOL_MAIN_MAX=5, DB_POOL_SITE_MAX=5, WEBWOW_MAX_SITE_POOLS=20 (LRU: idle
# site pools beyond the cap are closed). Recommended with the defaults: DB_POOL_MAX=10.
DB_POOL_MAIN_MAX=
DB_POOL_SITE_MAX=
WEBWOW_MAX_SITE_POOLS=

# --- Admin / login ---------------------------------------------------------
# Owner account, created automatically on first start when no user exists.
# The env password is always accepted for this account (recovery), so keep it
# secret. Leave ADMIN_PASSWORD empty to create the first account through the
# welcome wizard in the builder instead.
ADMIN_EMAIL=admin@webwow.local
ADMIN_PASSWORD=

# Session cookie `Secure` flag. Default: follows the request protocol
# (x-forwarded-proto from a reverse proxy, else the request URL), so plain-http
# LAN setups keep working. Force it with true/false when a proxy hides the scheme.
WEBWOW_SECURE_COOKIES=

# Secret used to sign the session cookie and page-auth cookies.
# REQUIRED in production - generate with: openssl rand -hex 32
# (If unset, a random per-process secret is used: every restart logs everyone out.)
PAGE_AUTH_SECRET=

# --- Storage / server ------------------------------------------------------
# Directory for uploaded assets (defaults to ./uploads; /app/uploads in Docker).
UPLOAD_DIR=./uploads
# Port used by `npm run dev` / `npm run start` / docker-entrypoint.sh (default 3002).
PORT=3002
# Public URL of the site (absolute links in sitemap / OG tags). Optional.
NEXT_PUBLIC_SITE_URL=

# --- Optional: Templates API ----------------------------------------------
NEXT_PUBLIC_TEMPLATE_API_URL=
TEMPLATE_API_URL=
TEMPLATE_UPLOAD_API_KEY=

# --- Optional: Google Fonts API Key (only to used to execute `npm run fonts:update`)
GOOGLE_FONTS_API_KEY=

# --- Optional: AI builder (BYOK) -------------------------------------------
# Set an API key for at least one provider to enable the in-app AI agent.
# Keys can also be added in Settings → Agent instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# GOOGLE_API_KEY works too.
GEMINI_API_KEY=
# Optional: override the default model (defaults to claude-sonnet-5).
ANTHROPIC_MODEL=
# Optional: seconds one AI chat request may run before the platform kills it.
# Must match the AI chat route's maxDuration in vercel.json (300 by default —
# the Vercel hobby-plan maximum). Raise both together on paid Vercel plans.
# (Webwow runs on its own server; only relevant if you put a proxy timeout in front.)
AI_CHAT_MAX_DURATION=

# --- Optional: Maps embeds ------------------------------------------------
MAPBOX_ACCESS_TOKEN=
GOOGLE_MAPS_EMBED_API_KEY=

# --- Optional: secrets for cron / cache routes ------------------------------
# Protects POST /ycode/api/revalidate and /api/cron/airtable-webhooks when you
# call them from an external scheduler.
REVALIDATE_SECRET=
CRON_SECRET=

# --- Debug only ------------------------------------------------------------
# Set to `true` to skip auth on /ycode/preview routes. Never enable in production.
DISABLE_PREVIEW_AUTH=
